# PhytoGuard AI - Streamlit dashboard container
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PORT=8501

WORKDIR /app

COPY requirements-ui.txt .
RUN pip install --no-cache-dir -r requirements-ui.txt

COPY app/ app/

EXPOSE 8501

CMD streamlit run app/streamlit_app.py --server.port ${PORT} --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false
